# Corpus, indexes, vectors — tens of GB, never committed.
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.faiss
*.bin
*.parquet

# Python
__pycache__/
*.py[cod]
# Any virtualenv, however suffixed. `.venv/` alone missed `.venv-vllm/` and a plain
# `git add -A` committed 3.4 GB of torch and CUDA libraries.
.venv*/
venv*/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Web
web/node_modules/
web/dist/

# Local overrides
config.local.yaml
.env
